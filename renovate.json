{
  "extends": ["config:base"],
  "platform": "gitlab",
  "enabledManagers": ["gradle"],
  "automerge": false,
  "minimumReleaseAge": "3 days",
  "dependencyDashboard": true,
  "labels": ["dependencies", "renovate"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "gitlabci": {
    "fileMatch": ["\\.gitlab-ci\\.ya?ml$", "(^|/)\\.gitlab/ci/.+\\.ya?ml$"]
  }  
}