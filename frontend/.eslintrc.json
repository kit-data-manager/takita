{
	"env": {
		"browser": true,
		"commonjs": true,
		"es2021": true,
		"jest": true,
		"node": true
	},
	"extends": [
		"eslint:recommended",
		"plugin:prettier/recommended"
	],
	"parser": "@babel/eslint-parser",
	"parserOptions": {
		"ecmaVersion": "latest"
	},
	"plugins": [
		"@stylistic/js"
	],
	"rules": {
		"@stylistic/js/max-len": [
			"warn", {
				"code": 120
			}
		],
		"no-unused-vars": [
			"warn", {
				"argsIgnorePattern": "^_"
			}
		]
	}
}
